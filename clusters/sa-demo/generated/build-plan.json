{
  "apiVersion": "tmprl-demo.cloud/v1alpha1",
  "imageRepositoryPrefix": "tmprl-dem-cld",
  "kind": "BuildPlan",
  "projects": [
    {
      "builds": [
        {
          "components": [
            "web"
          ],
          "context": ".",
          "dockerfile": "registry/web/Dockerfile",
          "image": {
            "placeholder": "registry.invalid/tmprl-dem-cld/registry/web:git-sha",
            "repositoryName": "tmprl-dem-cld/registry/web",
            "tagTemplate": "git-${sourceCommitSha}",
            "uriTemplate": "${awsAccountId}.dkr.ecr.${awsRegion}.amazonaws.com/tmprl-dem-cld/registry/web:git-${sourceCommitSha}"
          },
          "name": "web"
        },
        {
          "components": [
            "worker"
          ],
          "context": ".",
          "dockerfile": "registry/worker/Dockerfile",
          "image": {
            "placeholder": "registry.invalid/tmprl-dem-cld/registry/worker:git-sha",
            "repositoryName": "tmprl-dem-cld/registry/worker",
            "tagTemplate": "git-${sourceCommitSha}",
            "uriTemplate": "${awsAccountId}.dkr.ecr.${awsRegion}.amazonaws.com/tmprl-dem-cld/registry/worker:git-${sourceCommitSha}"
          },
          "name": "worker"
        }
      ],
      "name": "registry",
      "source": {
        "branch": "main",
        "repo": "https://github.com/temporal-sa/tmprl-demo-cloud-demo-registry"
      }
    }
  ],
  "tagPolicy": {
    "source": "sourceCommitSha",
    "template": "git-${sourceCommitSha}"
  }
}
