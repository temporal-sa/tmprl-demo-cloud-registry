        },
        "userManaged": []
      },
      "temporalCloud": {
        "apiKey": {
          "action": "create-or-verify-or-rotate",
          "components": [
            "web",
            "worker"
          ],
          "namespace": "demo-registry",
          "rotateBeforeExpiryDays": 60,
          "scope": "namespace",
          "secretProperties": [
            "address",
            "namespace",
            "apiKey",
            "tls"
          ],
          "secretRemotePath": "tmprl-cloud-demo/demo-registry/temporal",
          "ttlDays": 365
        },
        "bootstrapCredential": {
          "kubernetesSecret": "temporal-cloud-bootstrap",
