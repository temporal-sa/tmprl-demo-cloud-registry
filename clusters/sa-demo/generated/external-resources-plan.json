{
  "apiVersion": "tmprl-demo.cloud/v1alpha1",
  "kind": "ExternalResourcesPlan",
  "projects": [
    {
      "ecrRepositories": [
        {
          "build": "backend",
          "components": [
            "backend"
          ],
          "name": "tmprl-cloud-demo/dejavu-tacos/backend"
        },
        {
          "build": "frontend",
          "components": [
            "frontend"
          ],
          "name": "tmprl-cloud-demo/dejavu-tacos/frontend"
        },
        {
          "build": "worker-python",
          "components": [
            "worker-python"
          ],
          "name": "tmprl-cloud-demo/dejavu-tacos/worker-python"
        }
      ],
      "iam": {
        "buildPushRepositories": [
          "tmprl-cloud-demo/dejavu-tacos/backend",
          "tmprl-cloud-demo/dejavu-tacos/frontend",
          "tmprl-cloud-demo/dejavu-tacos/worker-python"
        ],
        "externalSecretsReadPath": "tmprl-cloud-demo/dejavu-tacos/*"
      },
      "kubernetesNamespace": "tmprl-cloud-demo-dejavu-tacos",
      "name": "dejavu-tacos",
      "secretPrefix": "tmprl-cloud-demo/dejavu-tacos",
      "secretsManager": {
        "temporalBootstrap": {
          "managedBy": "platform",
          "properties": [
            "TEMPORAL_CLOUD_API_KEY",
            "TEMPORAL_CLOUD_ACCOUNT_ID",
            "TEMPORAL_CLOUD_REGION"
          ],
          "remotePath": "tmprl-cloud-demo/platform/temporal-cloud-bootstrap",
          "required": true
        },
        "temporalCredentials": {
          "managedBy": "platform",
          "properties": [
            "address",
            "namespace",
            "apiKey",
            "tls"
          ],
          "remotePath": "tmprl-cloud-demo/dejavu-tacos/temporal",
          "required": true
        },
        "userManaged": []
      },
      "temporalCloud": {
        "apiKey": {
          "action": "create-or-verify-or-rotate",
          "components": [
            "backend",
            "worker-python"
          ],
          "namespace": "dejavu-tacos",
          "rotateBeforeExpiryDays": 60,
          "scope": "namespace",
          "secretProperties": [
            "address",
            "namespace",
            "apiKey",
            "tls"
          ],
          "secretRemotePath": "tmprl-cloud-demo/dejavu-tacos/temporal",
          "ttlDays": 365
        },
        "bootstrapCredential": {
          "kubernetesSecret": "temporal-cloud-bootstrap",
          "requiredProperties": [
            "TEMPORAL_CLOUD_API_KEY",
            "TEMPORAL_CLOUD_ACCOUNT_ID",
            "TEMPORAL_CLOUD_REGION"
          ],
          "secretRemotePath": "tmprl-cloud-demo/platform/temporal-cloud-bootstrap"
        },
        "mode": "manual-until-provider-contract-is-implemented",
        "namespace": {
          "action": "create-or-verify",
          "deletionPolicy": "retain-until-explicitly-approved",
          "name": "dejavu-tacos"
        },
        "provider": "temporal-cloud",
        "required": true
      }
    },
    {
      "ecrRepositories": [
        {
          "build": "web",
          "components": [
            "web"
          ],
          "name": "tmprl-cloud-demo/demo-registry/web"
        },
        {
          "build": "worker",
          "components": [
            "worker"
          ],
          "name": "tmprl-cloud-demo/demo-registry/worker"
        }
      ],
      "iam": {
        "buildPushRepositories": [
          "tmprl-cloud-demo/demo-registry/web",
          "tmprl-cloud-demo/demo-registry/worker"
        ],
        "externalSecretsReadPath": "tmprl-cloud-demo/demo-registry/*"
      },
      "kubernetesNamespace": "tmprl-cloud-demo-demo-registry",
      "name": "demo-registry",
      "secretPrefix": "tmprl-cloud-demo/demo-registry",
      "secretsManager": {
        "temporalBootstrap": {
          "managedBy": "platform",
          "properties": [
            "TEMPORAL_CLOUD_API_KEY",
            "TEMPORAL_CLOUD_ACCOUNT_ID",
            "TEMPORAL_CLOUD_REGION"
          ],
          "remotePath": "tmprl-cloud-demo/platform/temporal-cloud-bootstrap",
          "required": true
        },
        "temporalCredentials": {
          "managedBy": "platform",
          "properties": [
            "address",
            "namespace",
            "apiKey",
            "tls"
          ],
          "remotePath": "tmprl-cloud-demo/demo-registry/temporal",
          "required": true
        },
        "userManaged": []
      },
      "temporalCloud": {
        "apiKey": {
          "action": "create-or-verify-or-rotate",
          "components": [
            "web",
            "worker"
          ],
          "namespace": "demo-registry",
          "rotateBeforeExpiryDays": 60,
          "scope": "namespace",
          "secretProperties": [
            "address",
            "namespace",
            "apiKey",
            "tls"
          ],
          "secretRemotePath": "tmprl-cloud-demo/demo-registry/temporal",
          "ttlDays": 365
        },
        "bootstrapCredential": {
          "kubernetesSecret": "temporal-cloud-bootstrap",
          "requiredProperties": [
            "TEMPORAL_CLOUD_API_KEY",
            "TEMPORAL_CLOUD_ACCOUNT_ID",
            "TEMPORAL_CLOUD_REGION"
          ],
          "secretRemotePath": "tmprl-cloud-demo/platform/temporal-cloud-bootstrap"
        },
        "mode": "manual-until-provider-contract-is-implemented",
        "namespace": {
          "action": "create-or-verify",
          "deletionPolicy": "retain-until-explicitly-approved",
          "name": "demo-registry"
        },
        "provider": "temporal-cloud",
        "required": true
      }
    },
    {
      "ecrRepositories": [
        {
          "build": "app",
          "components": [
            "api",
            "web",
            "worker"
          ],
          "name": "tmprl-cloud-demo/temporal-agent-harness/app"
        }
      ],
      "iam": {
        "buildPushRepositories": [
          "tmprl-cloud-demo/temporal-agent-harness/app"
        ],
        "externalSecretsReadPath": "tmprl-cloud-demo/temporal-agent-harness/*"
      },
      "kubernetesNamespace": "tmprl-cloud-demo-temporal-agent-harness",
      "name": "temporal-agent-harness",
      "secretPrefix": "tmprl-cloud-demo/temporal-agent-harness",
      "secretsManager": {
        "temporalBootstrap": {
          "managedBy": "platform",
          "properties": [
            "TEMPORAL_CLOUD_API_KEY",
            "TEMPORAL_CLOUD_ACCOUNT_ID",
            "TEMPORAL_CLOUD_REGION"
          ],
          "remotePath": "tmprl-cloud-demo/platform/temporal-cloud-bootstrap",
          "required": true
        },
        "temporalCredentials": {
          "managedBy": "platform",
          "properties": [
            "address",
            "namespace",
            "apiKey",
            "tls"
          ],
          "remotePath": "tmprl-cloud-demo/temporal-agent-harness/temporal",
          "required": true
        },
        "userManaged": [
          {
            "components": [
              "api",
              "worker"
            ],
            "managedBy": "project-owner",
            "name": "anthropic-credentials",
            "remotePath": "tmprl-cloud-demo/temporal-agent-harness/anthropic-credentials"
          }
        ]
      },
      "temporalCloud": {
        "apiKey": {
          "action": "create-or-verify-or-rotate",
          "components": [
            "api",
            "worker"
          ],
          "namespace": "temporal-agent-harness",
          "rotateBeforeExpiryDays": 60,
          "scope": "namespace",
          "secretProperties": [
            "address",
            "namespace",
            "apiKey",
            "tls"
          ],
          "secretRemotePath": "tmprl-cloud-demo/temporal-agent-harness/temporal",
          "ttlDays": 365
        },
        "bootstrapCredential": {
          "kubernetesSecret": "temporal-cloud-bootstrap",
          "requiredProperties": [
            "TEMPORAL_CLOUD_API_KEY",
            "TEMPORAL_CLOUD_ACCOUNT_ID",
            "TEMPORAL_CLOUD_REGION"
          ],
          "secretRemotePath": "tmprl-cloud-demo/platform/temporal-cloud-bootstrap"
        },
        "mode": "manual-until-provider-contract-is-implemented",
        "namespace": {
          "action": "create-or-verify",
          "deletionPolicy": "retain-until-explicitly-approved",
          "name": "temporal-agent-harness"
        },
        "provider": "temporal-cloud",
        "required": true
      }
    }
  ]
}
