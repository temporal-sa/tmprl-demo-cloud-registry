        "mode": "manual-until-provider-contract-is-implemented",
        "namespace": {
          "action": "create-or-verify",
          "deletionPolicy": "retain-until-explicitly-approved",
          "name": "demo-registry"
        },
        "provider": "temporal-cloud",
        "required": true,
        "tcldCommandPlan": [
          {
            "command": [
              "tcld",
              "namespace",
              "get",
              "--namespace",
              "demo-registry"
            ],
            "step": "verify-namespace"
          },
          {
            "command": [
              "tcld",
              "namespace",
              "create",
              "--namespace",
              "demo-registry",
              "--region",
              "<temporal-region>",
              "--auth-method",
