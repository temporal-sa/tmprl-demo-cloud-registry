{
  "apiVersion": "tmprl-demo.cloud/v1alpha1",
  "kind": "ExternalResourcesPlan",
  "projects": [
    {
      "ecrRepositories": [
        {
          "build": "backend",
          "components": [
            "backend"
          ],
          "name": "tmprl-cloud-demo/dejavu-tacos/backend"
        },
        {
          "build": "frontend",
          "components": [
            "frontend"
          ],
          "name": "tmprl-cloud-demo/dejavu-tacos/frontend"
        },
        {
          "build": "worker-python",
          "components": [
            "worker-python"
          ],
          "name": "tmprl-cloud-demo/dejavu-tacos/worker-python"
        }
      ],
      "iam": {
        "buildPushRepositories": [
          "tmprl-cloud-demo/dejavu-tacos/backend",
          "tmprl-cloud-demo/dejavu-tacos/frontend",
          "tmprl-cloud-demo/dejavu-tacos/worker-python"
        ],
        "externalSecretsReadPath": "tmprl-cloud-demo/dejavu-tacos/*"
      },
      "kubernetesNamespace": "tmprl-cloud-demo-dejavu-tacos",
      "name": "dejavu-tacos",
      "secretPrefix": "tmprl-cloud-demo/dejavu-tacos",
      "secretsManager": {
        "temporalBootstrap": {
          "managedBy": "platform",
          "properties": [
            "TEMPORAL_CLOUD_API_KEY",
            "TEMPORAL_CLOUD_ACCOUNT_ID",
            "TEMPORAL_CLOUD_REGION"
          ],
          "remotePath": "tmprl-cloud-demo/platform/temporal-cloud-bootstrap",
          "required": true
        },
        "temporalCredentials": {
          "managedBy": "platform",
          "properties": [
            "address",
            "namespace",
            "apiKey",
            "tls"
          ],
          "remotePath": "tmprl-cloud-demo/dejavu-tacos/temporal",
          "required": true
        },
        "userManaged": []
      },
      "temporalCloud": {
        "apiKey": {
          "action": "create-or-verify-or-rotate",
          "components": [
            "backend",
            "worker-python"
          ],
          "namespace": "dejavu-tacos",
          "rotateBeforeExpiryDays": 60,
          "scope": "namespace",
          "secretProperties": [
            "address",
            "namespace",
            "apiKey",
            "tls"
          ],
          "secretRemotePath": "tmprl-cloud-demo/dejavu-tacos/temporal",
          "ttlDays": 365
        },
        "bootstrapCredential": {
          "kubernetesSecret": "temporal-cloud-bootstrap",
          "requiredProperties": [
            "TEMPORAL_CLOUD_API_KEY",
            "TEMPORAL_CLOUD_ACCOUNT_ID",
            "TEMPORAL_CLOUD_REGION"
          ],
          "secretRemotePath": "tmprl-cloud-demo/platform/temporal-cloud-bootstrap"
        },
        "mode": "manual-until-provider-contract-is-implemented",
        "namespace": {
          "action": "create-or-verify",
          "deletionPolicy": "retain-until-explicitly-approved",
          "name": "dejavu-tacos"
        },
        "provider": "temporal-cloud",
        "required": true,
        "tcldCommandPlan": [
          {
            "command": [
              "tcld",
              "namespace",
              "get",
              "--namespace",
              "dejavu-tacos"
            ],
            "step": "verify-namespace"
          },
          {
            "command": [
              "tcld",
              "namespace",
              "create",
              "--namespace",
              "dejavu-tacos",
              "--region",
              "<temporal-region>",
              "--auth-method",
              "api_key",
              "--enable-delete-protection"
            ],
            "step": "create-namespace"
          },
          {
            "command": [
              "tcld",
              "service-account",
              "create-scoped",
              "--name",
              "dejavu-tacos-runtime",
              "--namespace-permission",
              "dejavu-tacos=Write"
            ],
            "step": "create-scoped-service-account"
          },
          {
            "command": [
              "tcld",
              "apikey",
              "create",
              "--name",
              "dejavu-tacos-runtime",
              "--description",
              "tmprl-demo.cloud runtime key for dejavu-tacos",
              "--duration",
              "365d",
              "--service-account-id",
              "<service-account-id>"
            ],
            "step": "create-service-account-api-key"
          },
          {
            "command": [
              "tcld",
              "apikey",
              "list",
              "--owner-type",
              "service-account",
              "--owner-id",
              "<service-account-id>"
            ],
            "step": "list-service-account-api-keys"
          }
        ]
      }
    },
    {
