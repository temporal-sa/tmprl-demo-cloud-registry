# macos
.DS_Store

# python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
*.egg

# local tooling
.venv/
venv/
node_modules/

# local dev data
registry/web/data/
registry/web/status/

# local secrets / environment (never commit)
.env
.env.*
!.env.example

# generated build output
dist/
build/

# tailwind-compiled css (built by the registry/web Dockerfile)
registry/web/static/app.css

# opentofu / terraform (infra/)
# state never gets committed; the S3 backend is the source of truth.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# real tfvars can hold secrets; the .example is committed instead.
# covers both HCL (*.tfvars, *.auto.tfvars) and JSON (*.tfvars.json) var files.
*.tfvars
*.tfvars.json
!*.tfvars.example
# NB: .terraform.lock.hcl IS committed (pins provider versions) — not ignored.
