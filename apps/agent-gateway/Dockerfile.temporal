FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install the Temporal CLI, which bundles the local dev server and Web UI.
RUN curl -sSf https://temporal.download/cli.sh | sh \
    && cp /root/.temporalio/bin/temporal /usr/local/bin/temporal \
    && temporal --version

RUN mkdir -p /data

EXPOSE 7233 8233

# start-dev is for development only. --db-filename persists state to the volume so
# the demo survives container restarts. The Web UI is served on 8233.
#
# Two namespaces, one per team. "waypoint" is the Waypoint team's, who own the
# release pipeline and Agent Gateway; "security" belongs to the Security team, who
# own pre-prod scanning. Namespace separation is the honest boundary for "a
# different team runs this": independent retention, independent visibility,
# independent operator ownership, independent failure domain. It also gives the
# Web UI a namespace selector the demo can switch between, which makes two systems
# look like two systems. Creating a namespace on start-dev is free, so there is no
# reason to model this as anything weaker.
#
# Both are named after their team on purpose. This used to run in "default",
# which names nothing and reads as "the leftover one" every time the namespace
# selector is on screen -- the opposite of the point the selector is there to make.
#
# A third namespace, "default", exists anyway and is empty: start-dev always
# creates it and offers no flag to suppress it. Nothing runs there. If it is
# listed in the selector during a demo, that is why.
CMD ["temporal", "server", "start-dev", \
     "--ip", "0.0.0.0", \
     "--db-filename", "/data/temporal.db", \
     "--namespace", "waypoint", \
     "--namespace", "security", \
     "--ui-port", "8233"]
