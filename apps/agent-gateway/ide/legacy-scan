#!/bin/sh
# The Security team's legacy host scanner, runnable from anywhere in the IDE.
#
# The demo's script is a module inside the application package at /app, and a
# presenter's terminal opens in the workspace -- the inert stage-prop repo --
# so the bare `python -m security_scan.legacy_security_scan_script` a reader
# copies out of the walkthrough would fail on the import path, several lines
# into a live demo, for a reason that has nothing to do with what is being
# shown.
#
# There is no .venv here either: the image installs the application's
# dependencies system-wide, so `python` is already the right interpreter. That
# is why the walkthrough's `.venv/bin/` prefix is dropped rather than recreated.
#
# Arguments pass straight through, so this stays a thin alias to the real
# script rather than a second interface to keep in step with it.
cd /app || exit 1
exec python -m security_scan.legacy_security_scan_script "$@"
