# Keep build contexts small and deterministic. CodeBuild builds from a fresh Git
# checkout so most of this never exists there, but a local `docker compose build`
# is the same command with a developer's working tree underneath it, and an
# accidentally-copied .venv is both large and wrong for the image's platform.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.git/
.gitignore
.env
.env.*
!.env.example
*.log
*.sqlite
temporal.db
.DS_Store

# Documentation is read on GitHub, not from inside a container.
README.md
WALKTHROUGH.md

# Note what is deliberately NOT ignored: ide/ and edge/. Both are build contexts
# in their own right (ide/Dockerfile, edge/Dockerfile) and share this one context
# directory, so excluding either here would break its own build.
