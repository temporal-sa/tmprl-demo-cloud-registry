{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/temporal-sa/tmprl-demo-cloud-demo-registry/schemas/project.schema.json",
  "title": "ProjectDeploymentConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "registry",
    "source",
    "builds",
    "components",
    "ingress"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/dnsLabel"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "branch"],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^https://github\\.com/temporal-sa/[A-Za-z0-9_.-]+/?$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "registry": {
      "$ref": "#/$defs/registry"
    },
    "builds": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/dnsLabel"
      },
      "additionalProperties": {
        "$ref": "#/$defs/build"
      }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/dnsLabel"
      },
      "additionalProperties": {
        "$ref": "#/$defs/component"
      }
    },
    "ingress": {
      "$ref": "#/$defs/ingress"
    }
  },
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "dockerfile"],
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1
        },
        "dockerfile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build"],
      "properties": {
        "build": {
          "$ref": "#/$defs/dnsLabel"
        },
        "serviceName": {
          "$ref": "#/$defs/dnsLabel"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "$ref": "#/$defs/stringArray"
        },
        "args": {
          "$ref": "#/$defs/stringArray"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/componentPort"
          }
        },
        "env": {
          "$ref": "#/$defs/envList"
        },
        "temporalAccess": {
          "type": "boolean",
          "default": false
        },
        "worker": {
          "$ref": "#/$defs/worker"
        }
      }
    },
    "componentPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "containerPort", "servicePort"],
      "properties": {
        "name": {
          "$ref": "#/$defs/dnsLabel"
        },
        "containerPort": {
          "$ref": "#/$defs/portNumber"
        },
        "servicePort": {
          "$ref": "#/$defs/portNumber"
        }
      }
    },
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 63
    },
    "envList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/envVar"
      }
    },
    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/$defs/envName"
        },
        "value": {
          "type": "string"
        },
        "valueFrom": {
          "$ref": "#/$defs/envValueFrom"
        }
      },
      "oneOf": [
        {
          "required": ["value"]
        },
        {
          "required": ["valueFrom"]
        }
      ]
    },
    "envValueFrom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingressUrl": {
          "type": "boolean",
          "const": true
        },
        "serviceUrl": {
          "$ref": "#/$defs/serviceUrlRef"
        }
      },
      "oneOf": [
        {
          "required": ["ingressUrl"]
        },
        {
          "required": ["serviceUrl"]
        }
      ]
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subdomain"],
      "properties": {
        "subdomain": {
          "$ref": "#/$defs/subdomain"
        },
        "temporalAuthRequired": {
          "type": "boolean",
          "default": true
        },
        "component": {
          "$ref": "#/$defs/dnsLabel"
        },
        "port": {
          "$ref": "#/$defs/dnsLabel"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ingressRoute"
          }
        }
      },
      "oneOf": [
        {
          "required": ["component", "port"],
          "not": {
            "required": ["routes"]
          }
        },
        {
          "required": ["routes"],
          "not": {
            "anyOf": [
              {
                "required": ["component"]
              },
              {
                "required": ["port"]
              }
            ]
          }
        }
      ]
    },
    "ingressRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "port"],
      "properties": {
        "pathPrefix": {
          "type": "string",
          "pattern": "^/.*$"
        },
        "component": {
          "$ref": "#/$defs/dnsLabel"
        },
        "port": {
          "$ref": "#/$defs/dnsLabel"
        }
      }
    },
    "portNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "displayOrder": {
          "type": "integer",
          "minimum": 0
        },
        "readiness": {
          "$ref": "#/$defs/registryReadiness"
        },
        "tags": {
          "$ref": "#/$defs/registryLabels"
        },
        "temporalSdks": {
          "$ref": "#/$defs/registryLabels"
        },
        "links": {
          "$ref": "#/$defs/registryLinks"
        },
        "assets": {
          "$ref": "#/$defs/registryAssets"
        }
      }
    },
    "registryAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url", "kind"],
      "properties": {
        "label": {
          "$ref": "#/$defs/registryLabel"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "kind": {
          "$ref": "#/$defs/registryLabel"
        }
      }
    },
    "registryAssetList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registryAsset"
      }
    },
    "registryAssets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technical": {
          "$ref": "#/$defs/registryAssetList"
        },
        "nonTechnical": {
          "$ref": "#/$defs/registryAssetList"
        }
      }
    },
    "registryLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "registryLabels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/registryLabel"
      }
    },
    "registryLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "label": {
          "$ref": "#/$defs/registryLabel"
        }
      }
    },
    "registryLinks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speakerNotes": {
          "$ref": "#/$defs/registryLink"
        }
      }
    },
    "registryReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "maxScore"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "maxScore": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "serviceUrlRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": {
          "$ref": "#/$defs/dnsLabel"
        },
        "port": {
          "$ref": "#/$defs/dnsLabel"
        },
        "scheme": {
          "type": "string",
          "enum": ["http", "https"],
          "default": "http"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "subdomain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
      "not": {
        "pattern": "(^|\\.)tmprl-demo\\.cloud$"
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskQueue"],
      "properties": {
        "taskQueue": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
